+    /// Whether an absolute path is inside Bun's install cache directory.
+    /// On Android the default install backend is symlink, so packages in
+    /// node_modules are symlinks into the cache. Rewriting the module path
+    /// to the cache realpath breaks transitive resolution (the node_modules
+    /// walk-up starts from the cache, where sibling packages are absent).
+    /// Keeping the logical node_modules path reproduces the hardlink backend
+    /// behavior used on desktop.
+    fn isBunCachePath(this: *ThisResolver, abs_path: string) bool {
+        if (abs_path.len == 0) return false;
+        if (this.bun_cache_path) |cache_path| {
+            if (cache_path.len == 0) return false;
+            if (cache_path.len > abs_path.len) return false;
+            if (!bun.strings.hasPrefix(abs_path, cache_path)) return false;
+            // Path-aware: a match must end at a path separator, so sibling
+            // directories like "cache_foo" are not mistaken for the cache.
+            if (abs_path.len > cache_path.len and abs_path[cache_path.len] != std.fs.path.sep) return false;
+            return true;
+        }
+        // Resolve the install cache directory lazily without initializing the
+        // full package manager (which can be null during `bun run`/`bun build`).
+        const resolved = if (this.env_loader) |env_loader|
+            PackageManager.fetchCacheDirectoryPath(env_loader, null).path
+        else
+            "";
+        this.bun_cache_path = if (resolved.len > 0)
+            bun.handleOom(bun.default_allocator.dupe(u8, resolved))
+        else
+            "";
+        return this.isBunCachePath(abs_path);
+    }
+
