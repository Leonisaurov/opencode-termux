@@ -266,6 +266,41 @@ pub const PackageUpdateInfo = struct {
     original_version: ?Semver.Version,
 };
 
+/// After a global install, verify that all packages tracked in the lockfile
+/// have a corresponding directory in the global node_modules.
+/// This helps catch cases where transitive dependencies were not properly hoisted.
+pub fn verifyGlobalPackagesInstalled(this: *PackageManager) !bool {
+    const lockfile = this.lockfile;
+    const packages = lockfile.packages.slice();
+
+    // Open the global node_modules directory
+    var global_link_dir = this.globalLinkDir();
+    defer global_link_dir.close();
+
+    if (packages.len <= 1) return false;
+
+    // Count actual installed directories in global node_modules
+    var dir_iter = global_link_dir.iterate();
+    var installed_count: usize = 0;
+    while (dir_iter.next() catch null) |entry| {
+        if (entry.kind == .directory or entry.kind == .sym_link) {
+            installed_count += 1;
+        }
+    }
+
+    // -1 because package_id 0 is the root meta-package
+    const expected_count = packages.len - 1;
+
+    if (installed_count < expected_count) {
+        if (PackageManager.verbose_install) {
+            Output.prettyErrorln("<d>[Global Install]<r> Expected {d} packages, found {d} in global node_modules.", .{ expected_count, installed_count });
+        }
+        return true;
+    }
+
+    return false;
+}
+
 pub fn clearCachedItemsDependingOnLockfileBuffer(this: *PackageManager) void {
     this.root_package_id.id = null;
 }
