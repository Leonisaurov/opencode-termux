diff --git a/src/jsc/bindings/MimallocCompat.h b/src/jsc/bindings/MimallocCompat.h
new file mode 100644
index 0000000..d4b4f1d
--- /dev/null
+++ b/src/jsc/bindings/MimallocCompat.h
@@ -0,0 +1,34 @@
+#pragma once
+
+// Mimalloc compatibility layer.
+//
+// On platforms where Bun uses mimalloc as its default allocator
+// (Linux, macOS, Windows), this header exposes the real mimalloc API.
+// On Android (bionic), Bun uses the system allocator (Scudo) instead
+// so that memory allocated by the runtime can safely cross the boundary
+// into native libraries compiled against the NDK (which also use Scudo).
+// The mi_* functions are thin wrappers over libc in mimalloc_compat.cpp
+// that keep the rest of the codebase compiling unchanged.
+
+#include "root.h"
+
+#if USE(BUN_MIMALLOC)
+#include "mimalloc.h"
+#include "mimalloc/types.h"
+#else
+#include <cstddef>
+
+extern "C" {
+void* mi_malloc(size_t size);
+void* mi_calloc(size_t count, size_t size);
+void* mi_realloc(void* p, size_t newsize);
+void mi_free(void* p);
+void* mi_zalloc(size_t size);
+void* mi_malloc_aligned(size_t size, size_t alignment);
+void* mi_expand(void* p, size_t newsize);
+void mi_collect(bool force);
+char* mi_stats_get_json(size_t, char*);
+char* mi_heap_dump_json(bool include_blocks, bool hash_addresses);
+void mi_process_info(size_t* elapsed_msecs, size_t* user_msecs, size_t* system_msecs, size_t* current_rss, size_t* peak_rss, size_t* current_commit, size_t* peak_commit, size_t* page_faults);
+}
+#endif
