--- /dev/null
+++ b/src/bun_alloc/bionic.zig
@@ -0,0 +1,17 @@
+/// The bionic allocator — the Android system allocator.
+///
+/// Bun on Android uses bionic's system allocator (Scudo) instead of
+/// mimalloc so that memory allocated by the runtime can safely cross
+/// the boundary into native libraries compiled against the NDK (which
+/// also use Scudo). mimalloc and Scudo maintain incompatible chunk
+/// headers; freeing a mimalloc allocation through Scudo (or vice versa)
+/// is detected as heap corruption and aborts the process.
+pub const c_allocator = std.heap.c_allocator;
+pub const z_allocator = @import("./fallback/z.zig").allocator;
+
+/// libc can free allocations without being given their size.
+pub fn freeWithoutSize(ptr: ?*anyopaque) void {
+    std.c.free(ptr);
+}
+
+const std = @import("std");
