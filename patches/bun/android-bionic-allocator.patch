diff --git a/src/jsc/bindings/MimallocCompat.h b/src/jsc/bindings/MimallocCompat.h
new file mode 100644
index 0000000..1111f7e
--- /dev/null
+++ b/src/jsc/bindings/MimallocCompat.h
@@ -0,0 +1,65 @@
+#pragma once
+
+// Mimalloc compatibility layer.
+//
+// On platforms where Bun uses mimalloc as its default allocator
+// (Linux, macOS, Windows), this header exposes the real mimalloc API.
+// On Android (bionic), Bun uses the system allocator (Scudo) instead
+// so that memory allocated by the runtime can safely cross the boundary
+// into native libraries compiled against the NDK (which also use Scudo).
+// The mi_* functions are thin wrappers over libc in mimalloc_compat.cpp
+// that keep the rest of the codebase compiling unchanged.
+
+#include "root.h"
+
+#if USE(BUN_MIMALLOC)
+#include "mimalloc.h"
+#include "mimalloc/types.h"
+#else
+#include <cstddef>
+
+struct mi_heap_s;
+
+using mi_output_fun = void (*)(const char* message, void* arg);
+
+extern "C" {
+// Allocation.
+void* mi_malloc(size_t size);
+void* mi_calloc(size_t count, size_t size);
+void* mi_realloc(void* p, size_t newsize);
+void mi_free(void* p);
+void* mi_zalloc(size_t size);
+void* mi_expand(void* p, size_t newsize);
+void* mi_malloc_aligned(size_t size, size_t alignment);
+void* mi_realloc_aligned(void* p, size_t newsize, size_t alignment);
+void mi_free_size(void* p, size_t size);
+void mi_free_size_aligned(void* p, size_t size, size_t alignment);
+
+// Heap management.
+mi_heap_s* mi_heap_new();
+void mi_heap_destroy(mi_heap_s* heap);
+mi_heap_s* mi_heap_main();
+void mi_heap_collect(mi_heap_s* heap, bool force);
+bool mi_heap_contains(const mi_heap_s* heap, const void* p);
+void* mi_heap_malloc(mi_heap_s* heap, size_t size);
+void* mi_heap_malloc_aligned(mi_heap_s* heap, size_t size, size_t alignment);
+void* mi_heap_realloc_aligned(mi_heap_s* heap, void* p, size_t newsize, size_t alignment);
+
+// Introspection.
+size_t mi_usable_size(const void* p);
+size_t mi_malloc_usable_size(const void* p);
+bool mi_check_owned(const void* p);
+bool mi_is_in_heap_region(const void* p);
+
+// Stats (no-ops on the system allocator).
+void mi_collect(bool force);
+void mi_stats_print_out(mi_output_fun out, void* arg);
+void mi_thread_stats_print_out(mi_output_fun out, void* arg);
+char* mi_stats_get_json(size_t, char*);
+char* mi_heap_dump_json(bool include_blocks, bool hash_addresses);
+void mi_process_info(size_t* elapsed_msecs, size_t* user_msecs, size_t* system_msecs, size_t* current_rss, size_t* peak_rss, size_t* current_commit, size_t* peak_commit, size_t* page_faults);
+
+// Thread.
+void mi_thread_set_in_threadpool();
+}
+#endif
