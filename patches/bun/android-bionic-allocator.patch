diff --git a/src/jsc/bindings/mimalloc_compat.cpp b/src/jsc/bindings/mimalloc_compat.cpp
new file mode 100644
index 0000000..7f90624
--- /dev/null
+++ b/src/jsc/bindings/mimalloc_compat.cpp
@@ -0,0 +1,210 @@
+// Provides the mimalloc API on Android where Bun uses the system
+// allocator (Scudo) instead of mimalloc. This file is empty on
+// platforms where mimalloc is the default allocator.
+#include "MimallocCompat.h"
+#include <cstdlib>
+#include <cstring>
+#include <malloc.h>
+
+#if !USE(BUN_MIMALLOC)
+extern "C" {
+
+// ─── Allocation ────────────────────────────────────────────────
+void* mi_malloc(size_t size)
+{
+    return std::malloc(size);
+}
+
+void* mi_calloc(size_t count, size_t size)
+{
+    return std::calloc(count, size);
+}
+
+void* mi_realloc(void* p, size_t newsize)
+{
+    return std::realloc(p, newsize);
+}
+
+void mi_free(void* p)
+{
+    std::free(p);
+}
+
+void* mi_zalloc(size_t size)
+{
+    return std::calloc(1, size);
+}
+
+void* mi_expand(void* p, size_t newsize)
+{
+    // mi_expand expands in place or returns NULL — it never moves the block.
+    // std::realloc may move and free the old pointer, which breaks the Zig
+    // Allocator.resize contract ("if true, the pointer did not change") and
+    // causes silent use-after-free in the bundler's ArrayList grows.
+    if (p == nullptr)
+        return std::malloc(newsize);
+    if (newsize == 0) {
+        std::free(p);
+        return nullptr;
+    }
+    if (malloc_usable_size(p) >= newsize)
+        return p;
+    return nullptr;
+}
+
+static void* compat_aligned_alloc(size_t size, size_t alignment)
+{
+    // Normalize alignment: posix_memalign requires a power of two that is a
+    // multiple of sizeof(void*).
+    if (alignment < sizeof(void*))
+        alignment = sizeof(void*);
+    if ((alignment & (alignment - 1)) != 0)
+        alignment = 1u << (31u - __builtin_clz(alignment));
+    void* p = nullptr;
+    if (posix_memalign(&p, alignment, size) != 0)
+        return nullptr;
+    return p;
+}
+
+void* mi_malloc_aligned(size_t size, size_t alignment)
+{
+    return compat_aligned_alloc(size, alignment);
+}
+
+void* mi_realloc_aligned(void* p, size_t newsize, size_t alignment)
+{
+    // Preserve alignment across reallocation by allocating a fresh aligned
+    // block, copying the old contents, and freeing the old block.
+    void* result = compat_aligned_alloc(newsize, alignment);
+    if (result == nullptr)
+        return nullptr;
+    if (p != nullptr) {
+        size_t old_size = malloc_usable_size(p);
+        std::memcpy(result, p, old_size < newsize ? old_size : newsize);
+        std::free(p);
+    }
+    return result;
+}
+
+void mi_free_size(void* p, size_t)
+{
+    std::free(p);
+}
+
+void mi_free_size_aligned(void* p, size_t, size_t)
+{
+    std::free(p);
+}
+
+// ─── Heap management ───────────────────────────────────────────
+// The compat layer models every mimalloc heap as a single process-wide
+// singleton backed by the system allocator. MimallocArena is not used on
+// Android (use_mimalloc=false), so no per-heap state is ever needed.
+static char bunCompatMainHeapStorage[1];
+
+mi_heap_s* mi_heap_new()
+{
+    return reinterpret_cast<mi_heap_s*>(bunCompatMainHeapStorage);
+}
+
+void mi_heap_destroy(mi_heap_s*)
+{
+    // No-op: the compat heap is a static singleton with no state.
+}
+
+mi_heap_s* mi_heap_main()
+{
+    return reinterpret_cast<mi_heap_s*>(bunCompatMainHeapStorage);
+}
+
+void mi_heap_collect(mi_heap_s*, bool)
+{
+    // No-op: the system allocator manages memory on its own.
+}
+
+bool mi_heap_contains(const mi_heap_s*, const void*)
+{
+    return true;
+}
+
+void* mi_heap_malloc(mi_heap_s*, size_t size)
+{
+    return std::malloc(size);
+}
+
+void* mi_heap_malloc_aligned(mi_heap_s*, size_t size, size_t alignment)
+{
+    return compat_aligned_alloc(size, alignment);
+}
+
+void* mi_heap_realloc_aligned(mi_heap_s*, void* p, size_t newsize, size_t alignment)
+{
+    return mi_realloc_aligned(p, newsize, alignment);
+}
+
+// ─── Introspection ─────────────────────────────────────────────
+size_t mi_usable_size(const void* p)
+{
+    if (p == nullptr)
+        return 0;
+    return malloc_usable_size(const_cast<void*>(p));
+}
+
+size_t mi_malloc_usable_size(const void* p)
+{
+    if (p == nullptr)
+        return 0;
+    return malloc_usable_size(const_cast<void*>(p));
+}
+
+bool mi_check_owned(const void*)
+{
+    return true;
+}
+
+bool mi_is_in_heap_region(const void*)
+{
+    return true;
+}
+
+// ─── Stats (no-ops on the system allocator) ────────────────────
+void mi_collect(bool)
+{
+}
+
+void mi_stats_print_out(mi_output_fun, void*)
+{
+}
+
+void mi_thread_stats_print_out(mi_output_fun, void*)
+{
+}
+
+char* mi_stats_get_json(size_t, char*)
+{
+    return nullptr;
+}
+
+char* mi_heap_dump_json(bool, bool)
+{
+    return nullptr;
+}
+
+void mi_process_info(size_t* elapsed_msecs, size_t* user_msecs, size_t* system_msecs, size_t* current_rss, size_t* peak_rss, size_t* current_commit, size_t* peak_commit, size_t* page_faults)
+{
+    *elapsed_msecs = 0;
+    *user_msecs = 0;
+    *system_msecs = 0;
+    *current_rss = 0;
+    *peak_rss = 0;
+    *current_commit = 0;
+    *peak_commit = 0;
+    *page_faults = 0;
+}
+
+// ─── Thread ────────────────────────────────────────────────────
+void mi_thread_set_in_threadpool()
+{
+}
+}
+#endif
