+            }) |ghost_dir| {
+                // Replica la rama sintética folder (patrón :1892-1927 del case .folder):
+                // paquete sintético sin disco, sin scripts → el postinstall nunca corre.
+                var name_slice = this.lockfile.str(&name);
+                var package = Lockfile.Package{};
+                {
+                    var builder = this.lockfile.stringBuilder();
+
+                    builder.count(name_slice);
+                    builder.count(ghost_dir);
+
+                    bun.handleOom(builder.allocate());
+
+                    name_slice = this.lockfile.str(&name);
+
+                    package.name = builder.append(String, name_slice);
+                    package.name_hash = name_hash;
+
+                    package.resolution = Resolution.init(.{
+                        .folder = builder.append(String, ghost_dir),
+                    });
+
+                    package.scripts.filled = true;
+                    package.meta.setHasInstallScript(false);
+
+                    builder.clamp();
+                }
+
+                // these are always new
+                package = bun.handleOom(this.lockfile.appendPackage(package));
+
+                successFn(this, dependency_id, package.meta.id);
+                return .{ .package = this.lockfile.packages.get(package.meta.id), .is_first_time = true };
+            }
+            // fallback: ghost no creado → flujo npm normal (sin interceptar)
+        }
+    }
+    // ── END PATCH ───────────────────────────────────────────────────
     if (install_peer and behavior.isPeer()) {
         if (this.lockfile.package_index.get(name_hash)) |index| {
             const resolutions: []Resolution = this.lockfile.packages.items(.resolution);
@@ -2024,3 +2075,57 @@ const assignResolution = PackageManager.assignResolution;
 const assignRootResolution = PackageManager.assignRootResolution;
 const debug = PackageManager.debug;
 const failRootResolution = PackageManager.failRootResolution;
+
+/// PATCH: crea el paquete fantasma "bun" (folder dependency) que satisface los
+/// peer deps que declaran "bun" (p.ej. @bunli/*) sin descargar bun@npm (cuyo
+/// postinstall falla en Android). Idempotente: si ya existe, solo retorna la ruta.
+/// El buffer `buf` lo proporciona el caller para que `ghost_dir` (slice a `buf`)
+/// siga siendo válida tras el return.
+fn ensureBunGhostPackageExists(this: *PackageManager, buf: *bun.PathBuffer) ![]const u8 {
+    _ = this;
+    // Base: $BUN_INSTALL o fallback $XDG_CACHE_HOME/.bun o $HOME/.bun
+    // home_buf vive en el scope de la FUNCIÓN (no dentro de un blk) para que el
+    // slice resultante no sea un puntero colgante a stack (UB).
+    var home_buf: bun.PathBuffer = undefined;
+    const home = bun.env_var.XDG_CACHE_HOME.get() orelse (bun.env_var.HOME.get() orelse return error.MissingPackageJSON);
+    const base = bun.env_var.BUN_INSTALL.get() orelse Path.joinAbsStringBuf(home, &home_buf, &.{".bun"}, .auto);
+    const ghost_dir = Path.joinAbsStringBuf(base, buf, &.{"bun-ghost"}, .auto);
+
+    var pkg_json_buf: bun.PathBuffer = undefined;
+    const pkg_json = Path.joinAbsStringBuf(ghost_dir, &pkg_json_buf, &.{"package.json"}, .auto);
+    if (bun.sys.exists(pkg_json)) return ghost_dir;
+
+    var ghost_root = try std.fs.cwd().makeOpenPath(ghost_dir, .{});
+    defer ghost_root.close();
+
+    var bin_dir_buf: bun.PathBuffer = undefined;
+    const bin_dir_path = Path.joinAbsStringBuf(ghost_dir, &bin_dir_buf, &.{"bin"}, .auto);
+    var bin_dir = try std.fs.cwd().makeOpenPath(bin_dir_path, .{});
+    defer bin_dir.close();
+
+    // package.json: {"name":"bun","version":"<runtime>","main":"index.js","bin":{"bun":"bin/bun"}}
+    {
+        const f = try std.fs.cwd().createFile(pkg_json, .{});
+        defer f.close();
+        try f.writeAll("{\"name\":\"bun\",\"version\":\"" ++ bun.Global.package_json_version ++ "\",\"main\":\"index.js\",\"bin\":{\"bun\":\"bin/bun\"}}\n");
+    }
+    // index.js: re-export del builtin "bun"
+    {
+        var index_buf: bun.PathBuffer = undefined;
+        const index_path = Path.joinAbsStringBuf(ghost_dir, &index_buf, &.{"index.js"}, .auto);
+        const f = try std.fs.cwd().createFile(index_path, .{});
+        defer f.close();
+        try f.writeAll("export * from \"bun\";\n");
+    }
+    // bin/bun → symlink al ejecutable real (self-exe de bun)
+    // Idempotente: si el symlink ya existe (install concurrente o estado parcial), OK.
+    {
+        const exe = try bun.selfExePath();
+        std.posix.symlinkat(exe, bin_dir.fd, "bun") catch |err| switch (err) {
+            error.PathAlreadyExists => {},
+            else => return err,
+        };
+    }
+
+    return ghost_dir;
+}
