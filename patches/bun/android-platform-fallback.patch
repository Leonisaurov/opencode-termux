diff --git a/src/install/npm.zig b/src/install/npm.zig
index c65a70d..ee35cfd 100644
--- a/src/install/npm.zig
+++ b/src/install/npm.zig
@@ -651,6 +651,9 @@ pub const OperatingSystem = enum(u16) {
     };
 
     pub fn isMatch(this: OperatingSystem, target: OperatingSystem) bool {
+        if (comptime Environment.isAndroid) {
+            return (@intFromEnum(this) & (@intFromEnum(target) | OperatingSystem.linux)) != 0;
+        }
         return (@intFromEnum(this) & @intFromEnum(target)) != 0;
     }
 
diff --git a/src/jsc/VirtualMachine.zig b/src/jsc/VirtualMachine.zig
index 3e4d61f..ca37e41 100644
--- a/src/jsc/VirtualMachine.zig
+++ b/src/jsc/VirtualMachine.zig
@@ -1995,6 +1995,32 @@ pub fn resolveMaybeNeedsTrailingSlash(
         };
 
         {
+        // Platform fallback on Android: try linux-arm64 when android-arm64 fails
+        if (comptime bun.Environment.isAndroid) {
+            const spec_slice = specifier_utf8.slice();
+            if (bun.strings.indexOf(spec_slice, "android-arm64")) |pos| {
+                const before = spec_slice[0..pos];
+                const after = spec_slice[pos + "android-arm64".len..];
+                var buf: [bun.MAX_PATH_BYTES]u8 = undefined;
+                const linux_spec = std.fmt.bufPrint(&buf, "{s}linux-arm64{s}", .{ before, after }) catch null;
+                if (linux_spec) |ls| {
+                    result = .{ .path = "", .result = null };
+                    jsc_vm._resolve(&result, ls, normalizeSource(source_utf8.slice()), is_esm, is_a_file_path) catch {
+                        // Retry failed. Keep original error.
+                    };
+                    if (result.path.len > 0) {
+                        if (query_string) |query| {
+                            query.* = if (result.query_string.len > 0)
+                                bun.String.cloneUTF8(result.query_string)
+                            else
+                                bun.String.empty;
+                        }
+                        res.* = ErrorableString.ok(bun.String.cloneUTF8(result.path));
+                        return;
+                    }
+                }
+            }
+        }
             res.* = ErrorableString.err(err, (try bun.api.ResolveMessage.create(global, VirtualMachine.get().allocator, msg, source_utf8.slice())));
         }
 
