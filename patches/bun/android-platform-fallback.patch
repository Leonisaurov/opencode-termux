diff --git a/src/install/npm.zig b/src/install/npm.zig
index c65a70d..4f52cf4 100644
--- a/src/install/npm.zig
+++ b/src/install/npm.zig
@@ -651,6 +651,13 @@ pub const OperatingSystem = enum(u16) {
     };
 
     pub fn isMatch(this: OperatingSystem, target: OperatingSystem) bool {
+        if (comptime Environment.isAndroid) {
+            // On Android, also consider linux packages as compatible.
+            // Native bindings compiled for linux-arm64 share the same
+            // ARM64 ABI and work on Android (bionic vs glibc is
+            // handled by the .so loader).
+            return (@intFromEnum(this) & (@intFromEnum(target) | OperatingSystem.linux)) != 0;
+        }
         return (@intFromEnum(this) & @intFromEnum(target)) != 0;
     }
 
diff --git a/src/runtime/api/BunObject.zig b/src/runtime/api/BunObject.zig
index a23af46..01a0ccc 100644
--- a/src/runtime/api/BunObject.zig
+++ b/src/runtime/api/BunObject.zig
@@ -845,7 +845,27 @@ fn doResolveWithArgs(ctx: *jsc.JSGlobalObject, specifier: bun.String, from: bun.
     );
 
     if (!errorable.success) {
-        return ctx.throwValue(errorable.result.err.value);
+        if (comptime bun.Environment.isAndroid) {
+            const spec_utf8 = specifier_decoded.toUTF8(bun.default_allocator);
+            defer spec_utf8.deinit();
+            const spec_slice = spec_utf8.slice();
+            if (bun.strings.indexOf(spec_slice, "android-arm64")) |pos| {
+                const before = spec_slice[0..pos];
+                const after = spec_slice[pos + "android-arm64".len..];
+                var buf: [bun.MAX_PATH_BYTES]u8 = undefined;
+                const linux_spec = std.fmt.bufPrint(&buf, "{s}linux-arm64{s}", .{ before, after }) catch null;
+                if (linux_spec) |ls| {
+                    const linux_bun = bun.String.init(ls);
+                    try VirtualMachine.resolveMaybeNeedsTrailingSlash(
+                        &errorable, ctx, linux_bun, from, &query_string,
+                        is_esm, is_file_path, is_user_require_resolve,
+                    );
+                }
+            }
+        }
+        if (!errorable.success) {
+            return ctx.throwValue(errorable.result.err.value);
+        }
     }
     defer errorable.result.value.deref();
 
