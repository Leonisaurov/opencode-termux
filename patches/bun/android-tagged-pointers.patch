 pub fn main() void {
+    // On Android ARM64, disable the tagged address ABI (Top Byte Ignore)
+    // before any heap allocation. Scudo tags heap pointers in the top byte;
+    // Bun and JavaScriptCore pack tagged pointers in the low bits and can
+    // truncate pointers to 48 bits, which Scudo detects as "Pointer tag ...
+    // was truncated" and aborts. Disabling TBI makes Scudo skip tagging.
+    if (comptime Environment.isAndroid and builtin.target.cpu.arch.isAARCH64()) {
+        // PR_SET_TAGGED_ADDR_CTRL = 55, arg2 = 0 disables the tagged ABI.
+        _ = std.os.linux.prctl(55, 0, 0, 0, 0);
+    }
+
